{
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm dev *)",
      "Bash(pnpm start)",
      "Bash(pnpm start *)",
      "Bash(pnpm build)",
      "Bash(pnpm build *)",
      "Bash(pnpm run build)",
      "Bash(pnpm run build *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm check)",
      "Bash(pnpm check *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm db:migrate:local)",
      "Bash(pnpm db:generate *)",
      "Bash(pnpm db:migrate:local *)",
      "Bash(pnpm --filter web test *)",
      "Bash(pnpm --filter web lint)",
      "Bash(pnpm --filter web check)",
      "Bash(pnpm --filter web lint *)",
      "Bash(pnpm --filter web check *)"
    ],
    "deny": []
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/format-file.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.sh",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
