{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ⚠️ トップレベルの設定は「環境未指定（--env / CLOUDFLARE_ENV なし）時のフォールバック」として使われる。
  // ここに本番設定を置くと、環境指定を忘れた `wrangler deploy` や `vite build` がそのまま本番へ反映される。
  // そのため、トップレベルには本番とは別名・存在しないリソース ID を持つガード用の設定だけを置き、
  // 実際の環境設定はすべて `env` 配下に定義する（本番は `env.production`）。
  // 環境未指定でデプロイしようとした場合は、存在しない D1 / KV を参照して失敗する。
  "name": "your-app-name-unconfigured",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // NODE_ENV は nodejs_compat + compatibility_date >= 2025-04-01 により process.env へ反映される。
  // better-auth をはじめ process.env.NODE_ENV で本番判定を行うライブラリがあるため、環境ごとに明示する
  // （Workers ランタイムは NODE_ENV を自動設定しないため、未指定だと常に development 扱いになる）。
  "vars": {
    "ENVIRONMENT": "unconfigured",
    "BASE_URL": "http://localhost:3000",
    "NODE_ENV": "development",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-app-name-unconfigured",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "00000000000000000000000000000000",
    },
  ],
  "env": {
    "local": {
      "name": "your-app-name-local",
      "vars": {
        "ENVIRONMENT": "local",
        "BASE_URL": "http://localhost:3000",
        "NODE_ENV": "development",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "your-app-name-local",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION_KV",
          "id": "00000000000000000000000000000000",
        },
      ],
    },
    "preview": {
      "name": "your-app-name-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        "BASE_URL": "http://localhost:4173",
        // 本番ビルドをローカルで検証する環境のため production 相当にする
        "NODE_ENV": "production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "your-app-name-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION_KV",
          "id": "00000000000000000000000000000000",
        },
      ],
    },
    "develop": {
      "name": "your-app-name-develop",
      "vars": {
        "ENVIRONMENT": "develop",
        "BASE_URL": "https://your-app-name-develop.tomoya0209.workers.dev",
        "NODE_ENV": "production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "your-app-name-develop",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION_KV",
          "id": "01010101010101010101010101010101",
        },
      ],
    },
    "staging": {
      "name": "your-app-name-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "BASE_URL": "https://your-app-name-staging.tomoya0209.workers.dev",
        "NODE_ENV": "production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "your-app-name-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION_KV",
          "id": "01010101010101010101010101010101",
        },
      ],
    },
    "production": {
      "name": "your-app-name",
      "vars": {
        "ENVIRONMENT": "production",
        "BASE_URL": "https://your-app-name.your-account.workers.dev",
        "NODE_ENV": "production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "your-app-name",
          "database_id": "00000000-1111-2222-3333-444444444444",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION_KV",
          "id": "01010101010101010101010101010101",
        },
      ],
    },
  },
}
